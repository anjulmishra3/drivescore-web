# Supabase — create a project at https://supabase.com and copy these from
# Project Settings → API. The anon key is safe to expose to the browser
# (Row Level Security protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key — SERVER ONLY, never exposed to the browser. Used by the
# scoring/seed routes that need to bypass RLS. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
